# Docker Compose service configuration
COMPOSE_PROJECT_NAME=ai-ats-platform
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
POSTGRES_DB=ats_db
POSTGRES_PORT=5435
ADMINER_PORT=8080

# Backend configuration
# For Docker Compose use the `postgres` service hostname. For local development
# (running the backend directly) change the host to `localhost` and port
# to your local Postgres port.
DATABASE_URL=postgres://ats_user:ats_password@postgres:5432/ats_db?sslmode=disable
PORT=8000
APP_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# Frontend runtime configuration (when running via Docker Compose these point to the `backend` service).
# If you run the frontend locally (outside Docker), change `API_BACKEND_URL` and `NEXT_PUBLIC_API_URL` to use `http://localhost:8000`.
API_BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_URL=http://backend:8000

# AI provider configuration
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-pro
LLM_MODEL=gemini-1.5-pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=gpt-4o-mini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Embeddings and search tuning
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_WORKERS=2
SEMANTIC_SEARCH_TOP_K=200
RAG_TOP_K=5

# Optional tuning variables (uncomment to override defaults)
# FIT_WEIGHT_SKILLS=0.35
# FIT_WEIGHT_EXPERIENCE=0.20
# FIT_WEIGHT_EDUCATION=0.15
# FIT_WEIGHT_SENIORITY=0.15
# FIT_WEIGHT_LOCATION=0.10
# FIT_WEIGHT_CERTIFICATIONS=0.05
# AI_MATCH_WEIGHT_SEMANTIC=0.40
# AI_MATCH_WEIGHT_SKILLS=0.25
# AI_MATCH_WEIGHT_EXPERIENCE=0.15
# AI_MATCH_WEIGHT_EDUCATION=0.10
# AI_MATCH_WEIGHT_PROJECTS=0.10
# CANDIDATE_FILTER_ROLE_WEIGHT=0.30
# CANDIDATE_FILTER_SKILLS_WEIGHT=0.50
# CANDIDATE_FILTER_EXPERIENCE_WEIGHT=0.20
# CANDIDATE_FILTER_MIN_SCORE=40